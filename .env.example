# Telegram bot token from @BotFather (required for the bot)
BOT_TOKEN=<redacted>

# Moli browser automation (the bot drives gemini.google.com through it)
# MOLI_BIN: path to the moli binary (default ~/.local/bin/moli)
# MOLI_BIN=
# MOLI_PROFILE_DIR: persistent Moli profile — the Google login session
# lives here. Log in ONCE manually in this profile (see README), the bot
# then reuses it. Default ./moli-profile
# MOLI_PROFILE_DIR=./moli-profile
# MOLI_PORT: CDP port Moli serves on (default 9222)
# MOLI_PORT=9222
# MOLI_PROXY: HTTP proxy Moli must use for egress. Moli does NOT read
# proxy env vars — the bot passes this flag explicitly. Default $HTTP_PROXY.
# MOLI_PROXY=

# Gemini chat session to reuse (the "same session" chat URL). Empty =
# the bot starts a new chat on first use and stores its URL in LMDB.
# GEMINI_CHAT_URL=

# Local directory for job photos (input + polished result). Never committed.
# POLISH_JOBS_DIR=./jobs

# Comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
POLISH_ALLOWED_IDS=

# 1 = force the deterministic mock polisher (used by e2e tests): the worker
# returns a copy of the input image instead of driving Gemini, so tests run
# without a browser or a Google login.
POLISH_MOCK_AI=
